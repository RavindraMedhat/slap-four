# Copy this file to secrets.toml (gitignored - never commit real
# credentials) for local testing, and paste the same content into the
# "Secrets" box in the Streamlit Community Cloud dashboard when deploying.
#
# Get these values by downloading a service account key from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# It downloads a JSON file - copy each field from that JSON into the table below.

# Optional: once deployed, set this to your app's real URL so the lobby can
# show a clickable invite link (e.g. "https://slap-four.streamlit.app").
# Leave blank/omitted to just show the room code instead.
app_base_url = ""

[firebase_service_account]
type = "service_account"
project_id = "card-slap-game"
private_key_id = "REPLACE_ME"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
client_email = "REPLACE_ME@card-slap-game.iam.gserviceaccount.com"
client_id = "REPLACE_ME"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "REPLACE_ME"
universe_domain = "googleapis.com"
