*.pyc

# Streamlit secrets - never commit real credentials (bare filename so it's
# ignored no matter how deeply nested - streamlit_app/.streamlit/secrets.toml
# would NOT have matched a slash-qualified pattern anchored at the repo root)
secrets.toml

# Service account keys - never commit real credentials
*serviceAccountKey*.json
*-firebase-adminsdk-*.json

