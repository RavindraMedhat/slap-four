rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomCode} {
      // Any signed-in (anonymous) user may read room metadata - needed to
      // validate a room code exists before joining, and for all players to
      // watch game state. No card data lives here, so this is safe.
      allow read: if request.auth != null;

      // Every write (create_room, start_round, pass_card, slap resolution,
      // set_penalty, start_next_round) goes through a callable Cloud
      // Function using the Admin SDK, which bypasses these rules. Clients
      // never write this doc directly.
      allow write: if false;

      match /players/{uid} {
        allow read: if request.auth != null;

        // Player docs are created only by create_room/join_room (Admin SDK).
        allow create: if false;

        // A player may ONLY toggle their own presence flag - nothing that
        // affects game state (seatIndex, isHost, penaltyCount, displayName
        // after game start) is client-writable.
        allow update: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['connected']);

        allow delete: if false;
      }

      match /hands/{uid} {
        // Only the owning player can ever read their own hand. No one -
        // not even the owner - can write it from the client; only the
        // Admin SDK (Cloud Functions) deals/mutates hands.
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
